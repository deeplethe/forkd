[Unit]
Description=forkd master/node daemon
Documentation=https://github.com/deeplethe/forkd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Both halves in one process, which is the single-machine case. A node
# joining an existing master drops --master and adds --master-url.
ExecStart=/usr/local/bin/forkd-serve serve \
  --master --node \
  --bind 127.0.0.1:8889 \
  --state-db /var/lib/forkd/state.db \
  --pki-dir /var/lib/forkd/pki \
  --work-dir /var/lib/forkd \
  --api-token-file /etc/forkd/api-token
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
StateDirectory=forkd
LogsDirectory=forkd
RuntimeDirectory=forkd

# The daemon manages netns + cgroup, both of which need CAP_NET_ADMIN
# and CAP_SYS_ADMIN. It must be able to write under /sys/fs/cgroup
# (a delegated subtree is preferred over running as root). It also
# installs the iptables rules that keep a sandbox off the host's own
# services, which needs CAP_NET_RAW alongside CAP_NET_ADMIN.
# CAP_DAC_OVERRIDE is not optional, however much it looks like it:
# mounting the per-sandbox overlay fails without it. Bisected on bm --
# with the set above minus this one cap, `mount -t overlay` returns EPERM
# and util-linux reports it as "cannot mount overlay read-only", which
# reads like a filesystem problem and is not.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_KILL CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_KILL CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE

# Hardening — relaxed only where forkd genuinely needs the access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /run as well: `ip netns add` creates its namespace file under
# /run/netns, and the runsc state root defaults to /run/forkd-runsc.
# ProtectSystem=strict makes everything outside /dev, /proc and /sys
# read-only, so without this a node registers, polls, reports healthy --
# and fails every sandbox with
#     creating netns: ["ip","netns","add",...] failed
# which is what it did on bm until this line was added.
ReadWritePaths=/var/lib/forkd /var/log/forkd /sys/fs/cgroup /run
ProtectControlGroups=false
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Allowed namespaces (RestrictNamespaces is an allowlist; everything else
# returns EPERM on unshare/clone). Document the reason for each so a
# well-intentioned trim doesn't silently break a feature:
#   net    — per-sandbox network namespace (one veth pair per sandbox,
#            which is what keeps it off the control plane and its
#            siblings)
#   mnt    — per-sandbox mount namespace (overlay rootfs, volume)
#   user   — unprivileged subprocess isolation
#   pid    — per-sandbox PID namespace, so a sandbox sees only its own
#            processes
#   cgroup — required for per-child cgroup-v2 namespace under the
#            delegated subtree (without this, `unshare(CLONE_NEWCGROUP)`
#            returns EPERM — see #163)
RestrictNamespaces=net mnt user pid cgroup
RestrictRealtime=true
SystemCallArchitectures=native
# @mount, explicitly. `ip netns add` bind-mounts the namespace file,
# and the node mounts an overlay per sandbox, so mount(2) is on its
# critical path. It used to be excluded via `~@privileged`, and the
# kernel's own audit log is what it looked like:
#     comm="ip" exe="/usr/bin/ip" sig=31 syscall=165
# SIGSYS on mount. The node reported only `creating netns: [...] failed:`
# with an empty stderr, because the process was killed rather than having
# anything to say. A node that cannot mount cannot run a sandbox, so the
# filter keeps @system-service and subtracts @resources only.
SystemCallFilter=@system-service @mount
SystemCallFilter=~@resources

[Install]
WantedBy=multi-user.target
